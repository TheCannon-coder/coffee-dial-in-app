# Merged from root .gitignore + artifacts/dial-in/.gitignore
# When .easignore exists at the archive root, EAS uses ONLY this file (not .gitignore)
# so all patterns must be explicitly listed here.

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
tmp/
out-tsc/
coverage/
web-build/

# ── Expo / React Native ───────────────────────────────────────────────────────
.expo/
.expo-shared/
expo-env.d.ts

# ── Native dirs (generated by expo prebuild on EAS) ───────────────────────────
artifacts/dial-in/ios/
artifacts/dial-in/android/

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── Credentials / secrets ─────────────────────────────────────────────────────
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
.env
.env*.local

# ── Metro ─────────────────────────────────────────────────────────────────────
.metro-health-check*

# ── Debug / logs ──────────────────────────────────────────────────────────────
npm-debug.*
npm-debug.log
yarn-debug.*
yarn-error.*
yarn-error.log
lerna-debug.log*

# ── System / IDE ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log
/typings

# ── Replit internals ──────────────────────────────────────────────────────────
.cache/
.local/
.cursor/
.github/
attached_assets/
screenshots/
